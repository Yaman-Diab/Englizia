  "sc_how_much": {
    "id": "sc_how_much",
    "title": "بكم هذه؟",
    "kind": "written",
    "character": {
      "name": "Sami",
      "descriptionAr": "بائع في السوق",
      "avatarUrl": null
    },
    "intro": {
      "en": "Sami sells bags at the market. You like one of them.",
      "ar": "سامي يبيع الحقائب في السوق، وأعجبتك واحدة منها.",
      "audioUrl": "https://cdn.example.com/talk/sami_intro.mp3"
