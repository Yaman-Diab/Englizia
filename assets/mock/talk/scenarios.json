    "roleAr": "أنت تتسوّق في السوق.",
    "tasks": [
      {
        "id": "t_price",
        "ar": "اسأل عن سعر الحقيبة"
      },
      {
        "id": "t_buy",
        "ar": "اشترِ الحقيبة"
      },
      {
        "id": "t_bye",
        "ar": "اشكره وودّعه"
      }
    ],
    "maxTurns": 3,
    "opening": {
      "en": "Hello! Can I help you?",
      "ar": "مرحبًا! هل أستطيع مساعدتك؟",
      "audioUrl": "https://cdn.example.com/talk/sami_0.mp3"
    },
    "suggestions": [],
    "script": [
      {
        "kind": "repeat",
        "sentence": {
          "en": "How much is this bag?",
          "audioUrl": "https://cdn.example.com/talk/sami_s0.mp3"
        },
        "reply": {
          "en": "It's ten dollars.",
          "ar": "ثمنها عشرة دولارات.",
          "audioUrl": "https://cdn.example.com/talk/sami_1.mp3"
        },
        "taskId": "t_price"
      },
      {
        "kind": "choose",
        "options": [
          {
            "said": {
              "en": "I'll take it, please.",
              "audioUrl": "https://cdn.example.com/talk/sami_o1a.mp3"
            },
            "reply": {
              "en": "Great choice! Here you are.",
              "ar": "اختيار رائع! تفضّل.",
              "audioUrl": "https://cdn.example.com/talk/sami_2a.mp3"
            },
            "taskId": "t_buy"
          },
          {
            "said": {
              "en": "It's too expensive.",
              "audioUrl": "https://cdn.example.com/talk/sami_o1b.mp3"
            },
            "reply": {
              "en": "Sorry, that's the price. Anything else?",
              "ar": "آسف، هذا هو السعر. شيء آخر؟",
              "audioUrl": "https://cdn.example.com/talk/sami_2b.mp3"
            }
          },
          {
            "said": {
              "en": "I don't know.",
              "audioUrl": "https://cdn.example.com/talk/sami_o1c.mp3"
            },
            "reply": {
              "en": "Take your time. Anything else?",
              "ar": "خذ وقتك. شيء آخر؟",
              "audioUrl": "https://cdn.example.com/talk/sami_2c.mp3"
            }
          }
        ]
      },
      {
        "kind": "choose",
        "options": [
          {
            "said": {
              "en": "Thank you! Goodbye.",
              "audioUrl": "https://cdn.example.com/talk/sami_o2a.mp3"
            },
            "reply": {
              "en": "Goodbye! Have a nice day.",
              "ar": "مع السلامة! يومًا سعيدًا.",
              "audioUrl": "https://cdn.example.com/talk/sami_3a.mp3"
            },
            "taskId": "t_bye"
          },
          {
            "said": {
              "en": "Bye.",
              "audioUrl": "https://cdn.example.com/talk/sami_o2b.mp3"
            },
            "reply": {
              "en": "Bye!",
              "ar": "مع السلامة!",
              "audioUrl": "https://cdn.example.com/talk/sami_3b.mp3"
