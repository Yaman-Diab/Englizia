      "UserDto": {
        "required": [
          "id",
          "userName",
          "email",
          "displayName",
          "emailVerified",
          "roles",
          "timeZone",
          "uiLanguage"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
